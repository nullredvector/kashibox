{
  "manifest_version": 3,
  "name": "Local video saver",
  "version": "0.1.0",
  "description": "Finds the videos a page plays and saves them to your computer. Runs entirely locally.",
  "permissions": ["downloads", "webRequest", "storage", "scripting", "tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Save videos from this page", "default_popup": "popup.html" }
}
